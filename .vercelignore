# Vercel deploys the dashboard from repo root (Root Directory=apps/dashboard is a
# project-level setting applied after upload) — exclude everything the dashboard
# build doesn't need so the upload doesn't try to ship the whole monorepo,
# including the Python virtualenv and backend apps.
.venv/
apps/api/
apps/worker/
archive/
docs/
tests/
.git/
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
**/node_modules/
**/.next/
**/coverage/
**/playwright-report/
**/test-results/

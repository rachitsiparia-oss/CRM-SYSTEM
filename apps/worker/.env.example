# apps/worker environment template — DEPLOYMENT_AND_ENV.md section 5.3.
# Copy to .env for local development. Never commit real values.
# Server-only: nothing in this file is ever sent to the browser.

# --- Required in every environment ---
ENVIRONMENT=local
LOG_LEVEL=info
MAX_JOBS=10
JOB_TIMEOUT_SECONDS=300

# --- Optional in Phase 1; required once the worker actually runs jobs against Redis ---
# REDIS_URL=rediss://default:password@example.upstash.io:6379

# --- Required from Phase 2 (Database Foundation) onward ---
# Use the Supabase connection pooler (Session mode, port 5432), not the
# direct db.<ref>.supabase.co:5432 host — see apps/api/.env.example for why.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:password@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# --- Optional; enables Sentry error tracking when set ---
# SENTRY_DSN=replace_me

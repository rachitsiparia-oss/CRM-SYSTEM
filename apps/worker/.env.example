# apps/worker environment template — DEPLOYMENT_AND_ENV.md section 5.3.
# Copy to .env for local development. Never commit real values.
# Server-only: nothing in this file is ever sent to the browser.

# --- Required in every environment ---
ENVIRONMENT=local
LOG_LEVEL=info
MAX_JOBS=10
JOB_TIMEOUT_SECONDS=300

# --- Optional in Phase 1; required once the worker actually runs jobs against Redis ---
# REDIS_URL=rediss://default:password@example.upstash.io:6379
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database

# --- Optional; enables Sentry error tracking when set ---
# SENTRY_DSN=replace_me

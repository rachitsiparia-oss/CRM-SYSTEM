# apps/dashboard environment template — DEPLOYMENT_AND_ENV.md section 5.1.
# Copy to .env.local for local development. Never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is sent to the browser. Never put a secret,
# database credential, service-role key, or webhook secret behind that
# prefix — CLAUDE.md section 6.1 and DEPLOYMENT_AND_ENV.md section 4.4.

# --- Public (safe for the browser) ---
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase Auth needs these to run the browser auth flow. The anon key is
# safe to expose by design; it is not a secret. Required starting Phase 3
# (Authentication, Users, Roles, and Permissions) — leave unset until then.
# NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me

# Sentry error tracking (client, server, and edge — see instrumentation.ts
# and instrumentation-client.ts). Optional: unset disables reporting without
# crashing the app, same contract as apps/api and apps/worker's SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=replace_me
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

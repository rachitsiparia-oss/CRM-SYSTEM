# apps/api environment template — DEPLOYMENT_AND_ENV.md section 5.2.
# Copy to .env for local development. Never commit real values.
# Server-only: nothing in this file is ever sent to the browser.

# --- Required in every environment ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=info

# --- Optional in Phase 1-2; used from Phase 3 onward to build the
# Supabase password-recovery email's redirect link. Not a secret, not a
# security boundary (CORS is) — set to the real Vercel dashboard URL in
# staging/production.
DASHBOARD_BASE_URL=http://localhost:3000

# --- Optional in Phase 1; required from Phase 2 (Database Foundation) onward ---
# Use the Supabase connection pooler (Session mode, port 5432), not the
# direct db.<ref>.supabase.co:5432 host — the direct host is IPv6-only on
# most Supabase projects and will time out on networks without IPv6 egress.
# Find the exact pooler host and username format under Project Settings ->
# Database -> Connection string -> Session pooler in the Supabase dashboard.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:password@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# --- Optional in Phase 1-2; required from Phase 3 (Authentication) onward ---
# Server-only — never send these to the browser or log them.
# SUPABASE_URL=https://example.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only
# AUTH_JWT_SIGNING_SECRET — the project's JWT signing secret (Project
# Settings -> API -> JWT Settings), used to verify Supabase access tokens
# locally (HS256) without a network round trip per request.
# AUTH_JWT_SIGNING_SECRET=replace_me_server_only

# --- Optional in Phase 1; required once Redis/ARQ-dependent endpoints exist ---
# REDIS_URL=rediss://default:password@example.upstash.io:6379

# --- Optional; enables Sentry error tracking when set ---
# SENTRY_DSN=replace_me

# --- Deferred to their scheduled phase — do not invent values ---
# WHATSAPP_..., EMAIL_..., PAYMENT_... (Phase 15), OPENAI_API_KEY, GROQ_API_KEY (Phase 14)

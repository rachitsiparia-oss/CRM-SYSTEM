# apps/api environment template — DEPLOYMENT_AND_ENV.md section 5.2.
# Copy to .env for local development. Never commit real values.
# Server-only: nothing in this file is ever sent to the browser.

# --- Required in every environment ---
ENVIRONMENT=local
API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=info

# --- Optional in Phase 1; required from Phase 2 (Database Foundation) onward ---
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/database
# SUPABASE_URL=https://example.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace_me_server_only

# --- Optional in Phase 1; required once Redis/ARQ-dependent endpoints exist ---
# REDIS_URL=rediss://default:password@example.upstash.io:6379

# --- Optional; enables Sentry error tracking when set ---
# SENTRY_DSN=replace_me

# --- Deferred to their scheduled phase — do not invent values ---
# WHATSAPP_..., EMAIL_..., PAYMENT_... (Phase 15), OPENAI_API_KEY, GROQ_API_KEY (Phase 14)

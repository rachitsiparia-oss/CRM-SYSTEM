# RKPR Restaurant CRM — root environment template.
# See DEPLOYMENT_AND_ENV.md for full documentation of every variable.
# Copy this file to .env for local development; never commit real values.
#
# Per-service templates live in apps/dashboard/.env.example,
# apps/api/.env.example, and apps/worker/.env.example — this root file only
# documents values genuinely shared across services in local development.

ENVIRONMENT=local

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && $HOME/.local/bin/uv sync --package rkpr-api"
  },
  "deploy": {
    "startCommand": "$HOME/.local/bin/uv run --package rkpr-api uvicorn app.main:app --host 0.0.0.0 --port $PORT --app-dir apps/api",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
